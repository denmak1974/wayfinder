      "y": 20,
      "width": 1000,
      "height": 70,
      "text": "Project Wayfinder - Local-First Synchronization",
      "fontSize": 28,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "device",
